# Sion Bible server-side AI settings
# Secrets must never use the VITE_ prefix.

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional direct model overrides.
# Current names are preferred. Legacy NVIDIA_FAST_MODEL_1/2 and NVIDIA_MODEL are also supported.
NVIDIA_PRIMARY_MODEL=
NVIDIA_SECONDARY_MODEL=
NVIDIA_QUALITY_MODEL=
NVIDIA_DEEP_MODEL=

# Automatic NVIDIA model discovery and in-memory discovery cache.
NVIDIA_MODEL_DISCOVERY=1
NVIDIA_MODEL_DISCOVERY_CACHE_TTL_MS=21600000
NVIDIA_MODEL_BENCHMARK_CACHE_TTL_MS=86400000

# Hedged request timing.
NVIDIA_HEDGE_DELAY_MS=700
NVIDIA_QUALITY_DELAY_MS=1800
NVIDIA_DEEP_HEDGE_DELAY_MS=1100
NVIDIA_FAST_BACKUP_DELAY_MS=2400
NVIDIA_TOTAL_TIMEOUT_MS=15000
NVIDIA_DEEP_TOTAL_TIMEOUT_MS=26000

# Optional model filters. Values are comma-separated model IDs or ID fragments.
NVIDIA_MODEL_ALLOWLIST=
NVIDIA_MODEL_BLOCKLIST=

# Gemini fallback. Used only from Vercel/server-side API routes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=12000

# Set only temporarily outside production when detailed AI diagnostics are needed.
AI_DEBUG=0

# Frontend public settings.
VITE_APP_NAME=SION BIBLE
VITE_ENABLE_PWA=true

# Optional: override the same-origin contextual Bible-search endpoint.
# Normally leave this empty so the app uses /api/bible-search-intent.
VITE_AI_BIBLE_SEARCH_ENDPOINT=

# Optional future features.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
