# Server-only NVIDIA API settings for Vercel Serverless Functions and local scripts.
# Do not add VITE_ to secret keys.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_FAST_MODEL_1=meta/llama-3.1-8b-instruct
NVIDIA_FAST_MODEL_2=openai/gpt-oss-20b
NVIDIA_QUALITY_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Frontend public variables
VITE_APP_NAME=SION BIBLE
VITE_BIBLE_API_BASE_URL=https://api.getbible.net/v2
VITE_DEFAULT_BIBLE_VERSION=korean
VITE_ENABLE_PWA=true

# Optional future features
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
