# Server-only NVIDIA API settings for Vercel Serverless Functions and local scripts.
# Do not add VITE_ to secret keys.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Direct model overrides. If set, these take priority over discovery and benchmark cache.
NVIDIA_PRIMARY_MODEL=
NVIDIA_SECONDARY_MODEL=
NVIDIA_QUALITY_MODEL=
NVIDIA_DEEP_MODEL=

# Automatic model discovery and benchmark cache.
NVIDIA_MODEL_DISCOVERY=1
NVIDIA_MODEL_BENCHMARK_CACHE_TTL_MS=86400000

# Hedged request timing.
NVIDIA_HEDGE_DELAY_MS=700
NVIDIA_QUALITY_DELAY_MS=1800
NVIDIA_FAST_TIMEOUT_MS=6500
NVIDIA_TOTAL_TIMEOUT_MS=14000

# Optional model filters. Comma-separated model ids or id fragments.
NVIDIA_MODEL_ALLOWLIST=
NVIDIA_MODEL_BLOCKLIST=

# Default recommended models when available.
# primaryFastModel: openai/gpt-oss-20b
# secondaryFastModel: nvidia/nemotron-3-nano-30b-a3b
# qualityModel: nvidia/llama-3.3-nemotron-super-49b-v1.5, fallback nvidia/llama-3.3-nemotron-super-49b-v1
# deepModel: openai/gpt-oss-120b

# Frontend public variables
VITE_APP_NAME=SION BIBLE
VITE_BIBLE_API_BASE_URL=https://api.getbible.net/v2
VITE_DEFAULT_BIBLE_VERSION=korean
VITE_ENABLE_PWA=true

# Optional future features
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
